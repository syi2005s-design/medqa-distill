# API Key 配置（复制后填入）
# 注意：不要提交 .env 到 Git！

# DeepSeek（主力，性价比最高）
OPENAI_API_KEY=your_deepseek_key_here
# 基础 URL: https://api.deepseek.com/v1

# NVIDIA（托管 DeepSeek 模型，需 TLS1.2）
NVIDIA_API_KEY=your_nvidia_key_here
# 基础 URL: https://integrate.api.nvidia.com/v1
# 运行时需设置: export DISTILL_TLS12=1

# Agnes-CN（国内，flash 模型正常）
AGNES_CN_API_KEY=your_agnes_cn_key_here
# 基础 URL: https://api.agnes-ai.cn/v1

# Agnes-COM（国际版，可能无法访问）
AGNES_COM_API_KEY=your_agnes_com_key_here
# 基础 URL: https://apihub.agnes-ai.com/v1

# TokenRhythm（OpenAI 兼容聚合端点，推理模型需 max_tokens>=2048）
TOKENRHYTHM_API_KEY=your_tokenrhythm_key_here
# 基础 URL: https://tokenrhythm.studio/v1
# 模型: deepseek-v4-flash / kimi-k2.6 / qwen3.8-max 等
